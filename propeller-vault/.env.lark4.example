# Propeller — lark-4 deploy config.  `cp .env.lark4.example .env`, fill the blanks, then
# run the deploy steps below in order. Every var here overrides a lark-2 default in the
# scripts; unset vars fall back to lark-2 (so DO fill the chain-specific ones for lark-4).
#
# Legend:
#   [chain] = read off lark-4's money-market deployment (differs per chain — MUST set)
#   [out]   = printed by an earlier deploy step below (paste it back in)
#   [canon] = canonical / usually unchanged across larks (verify once)

# ── secrets ───────────────────────────────────────────────────────────────
PRIVATE_KEY=            # deployer key (must be a whitelisted EVMAccounts::ContractDeployer)

# ── money market + tokens (fill from lark-4) ────────────────────────────────
POOL=                   # [chain] Aave Pool proxy on lark-4
HOLLAR=                 # [chain] HOLLAR token (likely canonical 0x531a654d… — verify)
HOLLAR_VDEBT=           # [chain] HOLLAR variable-debt token (main market)
AETH=                   # [chain] aToken for ETH
APRIME=                 # [chain] aToken for PRIME
ETH=0x0000000000000000000000000000000100000022    # [canon] asset 34, if ids match
PRIME=0x000000000000000000000000000000010000002B  # [canon] asset 43, if ids match
GOV=0xAa7e0000000000000000000000000000000Aa7e0     # [canon] aave-manager (governance)

# ── risk params (optional; defaults shown) ──────────────────────────────────
# TARGET_HF=1050000000000000000        # 1.05e18
# DELEVER_TRIGGER=1100000000000000000  # 1.10e18
# SYNTH_LT_BPS=9800
# TVL_CAP=1000000000000000000000000    # 1_000_000e18

# ── filled in as you deploy (paste [out] values back here) ──────────────────
SYNTH=                  # [out] DeploySynth  → SyntheticToken
SUBLOOP=                # [out] DeployMain   → SubLoop (proxy)
SWAPPER=                # [out] HydraAugustus (aave-debt-swap repo) — else GOV placeholder

# ── tBTC vault (only if deploying it; else ignore) ──────────────────────────
IMPL=                   # [out] the deployed CollateralVault impl (from DeployMain / DeployVaultImpl)
ATBTC=                  # [chain] aToken for tBTC
TBTC=0x00000000000000000000000000000001000f453d   # [canon] asset 1000765, if ids match

# ═══════════════════════════════════════════════════════════════════════════
# DEPLOY ORDER (each: forge script script/<X>.s.sol:<X> --rpc-url $RPC --broadcast \
#                     --evm-version london --legacy --slow --gas-estimate-multiplier 200)
#
#   0. (aave-debt-swap repo) Deploy_HydraAugustus  → set SWAPPER above
#        env there: GOVERNANCE, PRIME, HOLLAR, ETH (+ TBTC if used) — registers the
#        compound-leg asset ids. Verify a router route exists for PRIME->ETH.
#   1. DeploySynth        → set SYNTH
#   2. DeployMain         → set SUBLOOP (+ note the CollateralVault impl for IMPL)
#   3. DeployHarvester    (env: SUBLOOP, PRIME, GOV)
#   4. DeployVaultTBTC    (optional)
#
# Then the governance wiring referendum (see scripts/propeller-wire-lark.mjs, repointed to
# lark-4): grantRole(MINTER), registerVault, setTranches, configureDca(222,43,1043,143,…),
# setHarvester, setCompoundSlippageBps, addVault — PLUS grantRole(GUARDIAN_ROLE, techCommittee)
# on BOTH the vault and the SubLoop (P-4). Then fund + repoint the looper bot.
#
# ⚠️ Before deploying: confirm lark-4's runtime has Router at pallet index 67 / DCA at 66
#    (DcaDispatch pins these); a different runtime version breaks the router swaps.

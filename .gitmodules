[submodule "hdcl-vault/lib/forge-std"]
	path = hdcl-vault/lib/forge-std
	url = https://github.com/foundry-rs/forge-std
[submodule "hdcl-vault/lib/openzeppelin-contracts"]
	path = hdcl-vault/lib/openzeppelin-contracts
	url = https://github.com/OpenZeppelin/openzeppelin-contracts
[submodule "hdcl-vault/lib/openzeppelin-contracts-upgradeable"]
	path = hdcl-vault/lib/openzeppelin-contracts-upgradeable
	url = https://github.com/OpenZeppelin/openzeppelin-contracts-upgradeable
[submodule "hdcl-vault/lib/decentral-contracts"]
	path = hdcl-vault/lib/decentral-contracts
	url = https://github.com/gabrielfst30/decentral-contracts
[submodule "hdcl-vault/lib/solmate"]
	path = hdcl-vault/lib/solmate
	url = https://github.com/transmissions11/solmate
[submodule "hdcl-vault/lib/openzeppelin-contracts-upgradeable-v5"]
	path = hdcl-vault/lib/openzeppelin-contracts-upgradeable-v5
	url = https://github.com/OpenZeppelin/openzeppelin-contracts-upgradeable
	branch = release-v5.0
[submodule "hdcl-vault/lib/openzeppelin-contracts-v5"]
	path = hdcl-vault/lib/openzeppelin-contracts-v5
